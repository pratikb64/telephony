{
	"compilerOptions": {
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"target": "es2021",
		"module": "esnext",
		"moduleResolution": "node",
		"jsx": "preserve",
		"types": [
			"unplugin-icons/types/vue",
			"vite/client"
		],
		"declaration": true,
		"declarationDir": "./dist/types",
		"outDir": "./dist"
	},
	"include": [
		"src",
		"src/*",
		"src/**/*.d.ts",
		"src/**/*.ts",
		"src/**/*.tsx",
		"src/**/*.js",
		"src/**/*.jsx",
		"src/**/*.vue"
	],
	"exclude": [
		"node_modules"
	]
}